{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React Library (source / JIT package)",
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  }
}
