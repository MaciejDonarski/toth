generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Tenancy & identity
// Every tenant-owned table carries `companyId` (RLS-ready, see with-tenant.ts).
// -----------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  WORKER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model Company {
  id        String   @id @default(cuid())
  name      String
  userLimit Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  invitations Invitation[]
}

model User {
  id                String     @id @default(cuid())
  companyId         String
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Always stored normalized (trimmed, lowercase). Unique across all companies.
  email             String     @unique
  name              String?
  /// E.164, e.g. +48600100200.
  phone             String?
  /// Key of the Tailwind-500 palette (core/users/domain/user-color.ts); avatar background.
  color             String
  passwordHash      String
  role              Role
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  passwordChangedAt DateTime   @default(now())
  lastLoginAt       DateTime?
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  termsAcceptedAt   DateTime?
  termsVersion      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions        Session[]
  trustedDevices  TrustedDevice[]
  loginChallenges LoginChallenge[]
  authTokens      AuthToken[]
  invitationsSent Invitation[]     @relation("InvitedBy")
  workingHours    WorkingHours[]

  @@index([companyId])
}

// -----------------------------------------------------------------------------
// Sessions & login flow
// Secrets are never stored in plain text: only SHA-256 / HMAC hashes.
// -----------------------------------------------------------------------------

/// Weekly working hours: one range per weekday; no row = day off.
/// Wall-clock minutes since midnight, no time zone.
model WorkingHours {
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ISO weekday: 1 = Monday … 7 = Sunday.
  weekday     Int
  startMinute Int
  endMinute   Int

  @@id([userId, weekday])
}

/// Server-side session. The Auth.js JWT only carries this row's id.
model Session {
  id                String    @id
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Denormalized for RLS and auditing.
  companyId         String
  createdAt         DateTime  @default(now())
  /// Last time the owner proved their credentials in this session (sign-in
  /// or password change). Sessions older than passwordChangedAt are invalid.
  authenticatedAt   DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  ip                String?
  userAgent         String?
  viaTrustedDevice  Boolean   @default(false)

  @@index([userId])
  @@index([companyId])
}

/// Second step of the login (email code), or a trusted-device bypass.
model LoginChallenge {
  id               String    @id
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// HMAC-SHA256 of the 6-digit code. Null when the challenge was satisfied by a trusted device.
  codeHash         String?
  codeExpiresAt    DateTime
  /// Hard end of the whole second-step window.
  expiresAt        DateTime
  attempts         Int       @default(0)
  resendCount      Int       @default(0)
  lastSentAt       DateTime
  verifiedAt       DateTime?
  /// SHA-256 of the single-use grant redeemed by Auth.js `authorize()`.
  grantHash        String?   @unique
  consumedAt       DateTime?
  viaTrustedDevice Boolean   @default(false)
  ip               String?
  userAgent        String?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model TrustedDevice {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token kept in the trusted-device cookie.
  tokenHash  String    @unique
  userAgent  String?
  /// Invalid once user.passwordChangedAt is later than this.
  createdAt  DateTime  @default(now())
  /// Hard expiry (30 days from trust), never extended.
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

/// Single-use email links: email verification and password reset.
model AuthToken {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AuthTokenType
  tokenHash  String        @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([userId, type])
}

model Invitation {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  role        Role
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([companyId, email])
  @@index([companyId])
}

// -----------------------------------------------------------------------------
// Audit & rate limiting
// -----------------------------------------------------------------------------

model AuthEvent {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  companyId String?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
}

/// Fixed-window counters, keyed e.g. `login:ip:1.2.3.4`.
model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
}
