# Copy to apps/app/.env (read by Next.js and the Prisma CLI).

# --- Database -----------------------------------------------------------------
# Locally both URLs point at the docker compose Postgres (`pnpm stack:up`).
# Supabase (prod):
#   DATABASE_URL = transaction pooler, port 6543, append ?pgbouncer=true (runtime)
#   DIRECT_URL   = direct/session connection, port 5432 (migrations, Prisma CLI)
DATABASE_URL="postgresql://toth:toth@localhost:5433/toth"
DIRECT_URL="postgresql://toth:toth@localhost:5433/toth"

# --- Auth.js (next-auth v5) ---------------------------------------------------
# Generate with: pnpm --filter @toth/app exec auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Not needed on Vercel (detected automatically).
AUTH_URL="http://localhost:3000"

# --- Mail ---------------------------------------------------------------------
# smtp   -> Mailpit locally (UI: http://localhost:8026)
# resend -> Resend API (prod)
MAIL_TRANSPORT="smtp"
MAIL_FROM="Toth <no-reply@localhost>"
SMTP_HOST="localhost"
SMTP_PORT="1026"
# Prod only.
RESEND_API_KEY=""
